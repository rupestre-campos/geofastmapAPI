# Copy to deploy/env/.env.pgbouncer and use with:
#   docker compose --env-file deploy/env/.env.pgbouncer -f deploy/compose/docker-compose.pgbouncer.yml up -d
#
# When Postgres runs **in Docker on the same host** (e.g. container `geofastmap_db`), prefer the db-network
# override so PgBouncer resolves the DB by container name (no host port hop):
#
#   docker compose --env-file deploy/env/.env.pgbouncer \
#     -f deploy/compose/docker-compose.pgbouncer.yml \
#     -f deploy/compose/docker-compose.pgbouncer.db-network.yml \
#     up -d
#
# edoburu/pgbouncer expects DATABASE_URL in **libpq** form (postgres://...), not postgresql+asyncpg://

# --- Backend: real Postgres (reachable from inside the pgbouncer container) ---

# Option A — Postgres container on same Docker network (use docker-compose.pgbouncer.db-network.yml merge):
PGBOUNCER_BACKEND_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@geofastmap_db:5432/geofastmap

# Option B — Postgres published on host only (no shared network); use base compose only:
# PGBOUNCER_BACKEND_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@host.docker.internal:5434/geofastmap

# If your DB compose project is not `geofastmap_api`, set the default bridge network name (docker network ls):
# PGBOUNCER_DB_NETWORK_NAME=myproject_default

# --- Listen on host (API on host / workers elsewhere connect here) ---
PGBOUNCER_PUBLISH=6432

# Optional tuning:
# PGBOUNCER_MAX_CLIENT_CONN=1000
# PGBOUNCER_DEFAULT_POOL_SIZE=25
# PGBOUNCER_RESERVE_POOL_SIZE=5

