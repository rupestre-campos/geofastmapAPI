DATABASE_URL=postgresql+asyncpg://postgres:postgres@YOUR_DB_HOST:5432/geofastmap
REDIS_URL=redis://YOUR_REDIS_HOST:6379/0
BULK_QUEUE_TYPE=redis
PROCESS_QUEUE_TYPE=redis
MOSAIC_QUEUE_TYPE=redis

# --- Throughput (single process) ---
# Parent jobs: how many mosaic plans run at once on this worker (0 = shard-only; see distributed block).
MOSAIC_WORKER_MAX_CONCURRENT=2
# Subtasks: concurrent STAC shard tasks per process (I/O bound; try 4–8 per CPU on shard boxes).
MOSAIC_SUBJOB_WORKER_CONCURRENCY=4

# Split/parallelize upstream STAC (parent + shards read these; shards should set STAC_* high).
MOSAIC_STAC_INITIAL_SPLIT_THRESHOLD_DEGREES=6
MOSAIC_STAC_INITIAL_SPLIT_GRID=0
MOSAIC_STAC_BBOX_PARALLELISM=12
MOSAIC_STAC_DATETIME_PARALLELISM=8
MOSAIC_STAC_CATALOG_PARALLELISM=8
# Keep >= catalog parallelism; raise with many catalogs (global HTTP budget per /search merge).
MOSAIC_STAC_TOTAL_INFLIGHT_MAX=32
MOSAIC_STAC_FETCH_LIMIT=500

MOSAIC_VOID_FILL_MAX_ROUNDS=6
MOSAIC_VOID_PINPOINT_MAX_PARTS=12
MOSAIC_VOID_FILL_MIN_UNCOVERED=0.001
MOSAIC_SAME_PASS_NUM_STRIPS=12

MOSAIC_FOOTPRINT_FETCH_MAX_CONCURRENT=16
MOSAIC_FOOTPRINT_CPU_MAX_CONCURRENT=8
MOSAIC_FOOTPRINT_FETCH_CONNECT_TIMEOUT_SECONDS=5
MOSAIC_FOOTPRINT_FETCH_READ_TIMEOUT_SECONDS=20
MOSAIC_FOOTPRINT_MAX_ITEMS=200

MOSAIC_JOB_HEARTBEAT_SECONDS=10
MOSAIC_JOB_STALE_AFTER_SECONDS=180
MOSAIC_JOB_CLIENT_TIMEOUT_SECONDS=1800

# Distributed: one mosaic split across Redis subtasks (enable on all mosaic worker processes).
MOSAIC_SUBJOB_QUEUE_ENABLED=false
# Per-subtask catalog fan-out (used inside shard STAC merge; tune on shard hosts).
MOSAIC_SUBJOB_CATALOG_PARALLELISM=8
# Coordinator: subtasks dispatched per barrier wave ≈ total shard concurrency across the fleet
# (sum of MOSAIC_SUBJOB_WORKER_CONCURRENCY × processes on all shard machines). Low = idle shards.
MOSAIC_SUBJOB_BBOX_DATETIME_PARALLELISM=32
MOSAIC_SUBJOB_CONSUME_SUBTASKS_WHILE_PARENT_ACTIVE=true
MOSAIC_SUBJOB_ROUND_TIMEOUT_SECONDS=300
MOSAIC_SUBJOB_MAX_RETRIES=1
MOSAIC_SUBJOB_RESULT_TTL_SECONDS=3600
MOSAIC_PARENT_FAIL_ON_PARTIAL=false

BULK_STORAGE_PATH=/data/bulk-uploads
TILES_STORAGE_PATH=/data/tiles

# --- Optional: coordinator vs shard overrides (typical production split) ---
# Coordinator only (parent queue, no local subtasks):
#   MOSAIC_WORKER_MAX_CONCURRENT=1
#   MOSAIC_SUBJOB_WORKER_CONCURRENCY=0
#   MOSAIC_SUBJOB_CONSUME_SUBTASKS_WHILE_PARENT_ACTIVE=false
#   MOSAIC_SUBJOB_QUEUE_ENABLED=true
#   MOSAIC_SUBJOB_BBOX_DATETIME_PARALLELISM=<~total subtask slots in cluster>
#
# Shard only (subtask queue, never parent):
#   MOSAIC_WORKER_MAX_CONCURRENT=0
#   MOSAIC_SUBJOB_WORKER_CONCURRENCY=8
#   MOSAIC_SUBJOB_CONSUME_SUBTASKS_WHILE_PARENT_ACTIVE=true
#   MOSAIC_SUBJOB_QUEUE_ENABLED=true
#   MOSAIC_STAC_CATALOG_PARALLELISM=12
#   MOSAIC_STAC_TOTAL_INFLIGHT_MAX=48
#   MOSAIC_SUBJOB_CATALOG_PARALLELISM=12
