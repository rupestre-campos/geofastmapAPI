DATABASE_URL=postgresql+asyncpg://postgres:postgres@YOUR_DB_HOST:5432/geofastmap
REDIS_URL=redis://YOUR_REDIS_HOST:6379/0
BULK_QUEUE_TYPE=redis
PROCESS_QUEUE_TYPE=redis
MOSAIC_QUEUE_TYPE=redis
REDIS_RETRY_BASE_SECONDS=1
REDIS_RETRY_MAX_SECONDS=30
REDIS_RETRY_ENQUEUE_MAX_ATTEMPTS=5
# Hot-path Redis reads (bulk cancel polls, parent shard aggregation). Raise on flaky LAN.
REDIS_RETRY_READ_MAX_ATTEMPTS=15
## Bulk ingest resilience/perf profile (large files)
BULK_IMPORT_BATCH_SIZE=2000
BULK_INSERT_PARTS_BATCH_SIZE=160
BULK_PROGRESS_HEARTBEAT_SECONDS=5
## immediate|deferred|best_effort (workers usually run best_effort/deferred for huge layers)
BULK_EXTENT_UPDATE_MODE=best_effort
BULK_DB_RETRY_MAX_ATTEMPTS=4
BULK_DB_RETRY_BASE_SECONDS=1
BULK_DB_RETRY_MAX_SECONDS=30
BULK_UPLOAD_SESSION_TTL_SECONDS=86400
BULK_UPLOAD_CHUNK_SIZE_BYTES=33554432
BULK_SHARDED_INGEST_ENABLED=true
BULK_SHARD_LINES_PER_PART=50000
# Standalone bulk worker: concurrent import threads per process (see app.worker_main). Watch Postgres max_connections.
BULK_WORKER_MAX_CONCURRENT=2
# Tile worker (app.tile_worker_main): poll interval while waiting for bulk import to finish on the same collection.
TILE_BUILD_BULK_WAIT_POLL_SECONDS=2

# --- Homogeneous mosaic workers (recommended default) ---
# Use the same env on every host: each process can dequeue parent jobs AND Redis STAC subtasks (and footprints if enabled).
# No separate "coordinator" vs "shard" config required. Optional dedicated-role overrides are at the bottom.

# --- Throughput (single process) ---
# Parent jobs: how many mosaic plans run at once on this worker (0 = shard-only; see optional overrides below).
MOSAIC_WORKER_MAX_CONCURRENT=2
# Subtasks: concurrent STAC shard tasks per process (I/O bound; try 4–8 per CPU on shard boxes).
MOSAIC_SUBJOB_WORKER_CONCURRENCY=4

# Split/parallelize upstream STAC (parent + shards read these; shards should set STAC_* high).
MOSAIC_STAC_INITIAL_SPLIT_THRESHOLD_DEGREES=6
MOSAIC_STAC_INITIAL_SPLIT_GRID=0
MOSAIC_STAC_BBOX_PARALLELISM=12
MOSAIC_STAC_DATETIME_PARALLELISM=8
MOSAIC_STAC_CATALOG_PARALLELISM=8
# Keep >= catalog parallelism; raise with many catalogs (global HTTP budget per /search merge).
MOSAIC_STAC_TOTAL_INFLIGHT_MAX=32
MOSAIC_STAC_FETCH_LIMIT=500

MOSAIC_VOID_FILL_MAX_ROUNDS=6
MOSAIC_VOID_PINPOINT_MAX_PARTS=12
MOSAIC_VOID_FILL_MIN_UNCOVERED=0.001
MOSAIC_SAME_PASS_NUM_STRIPS=12
# Greedy cover: stop adding more scenes if the best marginal cover is below this fraction of the current hole.
MOSAIC_GREEDY_MIN_MARGINAL_COVERAGE_FRACTION=0.005

MOSAIC_FOOTPRINT_FETCH_MAX_CONCURRENT=16
MOSAIC_FOOTPRINT_CPU_MAX_CONCURRENT=8
MOSAIC_FOOTPRINT_FETCH_CONNECT_TIMEOUT_SECONDS=5
MOSAIC_FOOTPRINT_FETCH_READ_TIMEOUT_SECONDS=20
MOSAIC_FOOTPRINT_MAX_ITEMS=200
# Optional: thumbnail footprint_display via Redis (async mosaic jobs; API must enable too).
MOSAIC_FOOTPRINT_DISTRIBUTED_ENABLED=false
MOSAIC_FOOTPRINT_DISTRIBUTED_WAVE=16
MOSAIC_FOOTPRINT_DISTRIBUTED_TIMEOUT_SECONDS=300
# 0 = use MOSAIC_SUBJOB_WORKER_CONCURRENCY for footprint queue consumers.
MOSAIC_FOOTPRINT_SUBJOB_WORKER_CONCURRENCY=0

MOSAIC_JOB_HEARTBEAT_SECONDS=10
MOSAIC_JOB_STALE_AFTER_SECONDS=180
MOSAIC_JOB_CLIENT_TIMEOUT_SECONDS=1800

# Distributed: one mosaic split across Redis subtasks (enable on API and all mosaic worker processes).
MOSAIC_SUBJOB_QUEUE_ENABLED=true
# Per-subtask catalog fan-out (used inside shard STAC merge; tune per host).
MOSAIC_SUBJOB_CATALOG_PARALLELISM=8
# Wave size ≈ total subtask slots (MOSAIC_SUBJOB_WORKER_CONCURRENCY × mosaic worker processes on the fleet).
# Single process on one machine: use ~4–8, not 32, or waves wait on one consumer.
MOSAIC_SUBJOB_BBOX_DATETIME_PARALLELISM=8
MOSAIC_SUBJOB_CONSUME_SUBTASKS_WHILE_PARENT_ACTIVE=true
MOSAIC_SUBJOB_ROUND_TIMEOUT_SECONDS=300
MOSAIC_SUBJOB_MAX_RETRIES=1
MOSAIC_SUBJOB_RESULT_TTL_SECONDS=3600
MOSAIC_PARENT_FAIL_ON_PARTIAL=false
# Federated STAC retries on transient errors (502/503/504/429): exponential backoff capped to 5 minutes.
STAC_SEARCH_HTTP_MAX_RETRIES=8
STAC_SEARCH_HTTP_RETRY_BACKOFF_SECONDS=2
STAC_SEARCH_HTTP_RETRY_BACKOFF_MAX_SECONDS=300
STAC_SEARCH_HTTP_MAX_PAGES=2
STAC_SEARCH_HTTP_PAGE_DELAY_SECONDS=0.25

BULK_STORAGE_PATH=/data/bulk-uploads
# GeoTIFF → COG output for raster collection jobs (app.worker_main). MUST match API and TiTiler
# RASTER_STORAGE_PATH and be the same shared directory (NFS/bind mount) on every host.
RASTER_STORAGE_PATH=/data/rasters
TILES_STORAGE_PATH=/data/tiles

# --- Optional: dedicated roles (advanced production split) ---
# Coordinator only (parent queue, no local subtasks):
#   MOSAIC_WORKER_MAX_CONCURRENT=1
#   MOSAIC_SUBJOB_WORKER_CONCURRENCY=0
#   MOSAIC_SUBJOB_CONSUME_SUBTASKS_WHILE_PARENT_ACTIVE=false
#   MOSAIC_SUBJOB_QUEUE_ENABLED=true
#   MOSAIC_SUBJOB_BBOX_DATETIME_PARALLELISM=<~total subtask slots in cluster>
#
# Shard only (subtask queue, never parent):
#   MOSAIC_WORKER_MAX_CONCURRENT=0
#   MOSAIC_SUBJOB_WORKER_CONCURRENCY=8
#   MOSAIC_SUBJOB_CONSUME_SUBTASKS_WHILE_PARENT_ACTIVE=true
#   MOSAIC_SUBJOB_QUEUE_ENABLED=true
#   MOSAIC_STAC_CATALOG_PARALLELISM=12
#   MOSAIC_STAC_TOTAL_INFLIGHT_MAX=48
#   MOSAIC_SUBJOB_CATALOG_PARALLELISM=12
#   MOSAIC_FOOTPRINT_DISTRIBUTED_ENABLED=true
#   MOSAIC_FOOTPRINT_SUBJOB_WORKER_CONCURRENCY=8
