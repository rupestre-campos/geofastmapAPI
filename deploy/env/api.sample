AUTH_SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://postgres:postgres@YOUR_DB_HOST:5432/geofastmap
REDIS_URL=redis://YOUR_REDIS_HOST:6379/0
BULK_QUEUE_TYPE=redis
BULK_STORAGE_PATH=/data/bulk-uploads
PROCESS_QUEUE_TYPE=redis
MOSAIC_QUEUE_TYPE=redis
# Only used by standalone mosaic worker process (jobs per process).
MOSAIC_WORKER_MAX_CONCURRENT=2
# Upstream STAC fan-out controls for one large mosaic job (used by mosaic worker):
MOSAIC_STAC_INITIAL_SPLIT_THRESHOLD_DEGREES=6
MOSAIC_STAC_INITIAL_SPLIT_GRID=0
MOSAIC_STAC_BBOX_PARALLELISM=8
TILES_STORAGE_PATH=/data/tiles
RASTER_STORAGE_PATH=/data/rasters
TITILER_INTERNAL_URL=http://YOUR_TITILER_OR_NGINX:8000
TITILER_TILE_CACHE_TTL_SECONDS=3600
# Mosaic raster tiles only (Redis); keys include revision — safe to raise (e.g. 604800 = 7d). 0 = same as TITILER_TILE_CACHE_TTL_SECONDS.
TITILER_MOSAIC_TILE_CACHE_TTL_SECONDS=86400
RASTER_INTERNAL_FETCH_BASE_URL=http://YOUR_API_HOST:8000
TITILER_INTERNAL_SECRET=change-me-titiler-secret
TITILER_HTTP_READ_TIMEOUT_SECONDS=600
# Per API worker: max parallel httpx calls to Titiler (0 = unlimited). Waiters are LIFO when saturated.
TITILER_UPSTREAM_MAX_CONCURRENT=8
# Observability tracing (Tempo via OTEL Collector in deploy/compose/docker-compose.observability.yml)
OBSERVABILITY_TRACING_ENABLED=false
OBSERVABILITY_SERVICE_NAME=geofast_api
OBSERVABILITY_OTLP_ENDPOINT=http://otel_collector:4317
OBSERVABILITY_TRACE_SAMPLE_RATIO=0.1
# STAC upstream (Earth Search, etc.): Redis-backed caches reduce repeat traffic and 403/rate-limit risk.
# POST /search merge cache TTL (seconds). Use 604800 (7d) in production if results staleness is acceptable.
STAC_SEARCH_CACHE_TTL_SECONDS=604800
# GET /collections listing per catalog (seconds). 604800 = 7d.
STAC_COLLECTIONS_CACHE_TTL_SECONDS=604800
# GET Item JSON (seconds); shared across API workers. 604800 = 7d.
STAC_ITEM_REDIS_CACHE_TTL_SECONDS=604800
