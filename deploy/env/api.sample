AUTH_SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://postgres:postgres@YOUR_DB_HOST:5432/geofastmap
REDIS_URL=redis://YOUR_REDIS_HOST:6379/0
BULK_QUEUE_TYPE=redis
BULK_STORAGE_PATH=/data/bulk-uploads
PROCESS_QUEUE_TYPE=redis
TILES_STORAGE_PATH=/data/tiles
RASTER_STORAGE_PATH=/data/rasters
TITILER_INTERNAL_URL=http://YOUR_TITILER_OR_NGINX:8000
TITILER_TILE_CACHE_TTL_SECONDS=3600
RASTER_INTERNAL_FETCH_BASE_URL=http://YOUR_API_HOST:8000
TITILER_INTERNAL_SECRET=change-me-titiler-secret
TITILER_HTTP_READ_TIMEOUT_SECONDS=600
# Observability tracing (Tempo via OTEL Collector in deploy/compose/docker-compose.observability.yml)
OBSERVABILITY_TRACING_ENABLED=false
OBSERVABILITY_SERVICE_NAME=geofast_api
OBSERVABILITY_OTLP_ENDPOINT=http://otel_collector:4317
OBSERVABILITY_TRACE_SAMPLE_RATIO=0.1
ENVIRONMENT=production
