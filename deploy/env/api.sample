AUTH_SECRET_KEY=change-me
API_UVICORN_WORKERS=8
DATABASE_URL=postgresql+asyncpg://postgres:postgres@YOUR_DB_HOST:5432/geofastmap
REDIS_URL=redis://YOUR_REDIS_HOST:6379/0
BULK_QUEUE_TYPE=redis
BULK_STORAGE_PATH=/data/bulk-uploads
## Bulk ingest resilience/perf profile (large files)
BULK_IMPORT_BATCH_SIZE=2000
BULK_INSERT_PARTS_BATCH_SIZE=160
BULK_PROGRESS_HEARTBEAT_SECONDS=5
## immediate|deferred|best_effort (deferred reduces tail latency for very large imports)
BULK_EXTENT_UPDATE_MODE=best_effort
BULK_DB_RETRY_MAX_ATTEMPTS=4
BULK_DB_RETRY_BASE_SECONDS=1
BULK_DB_RETRY_MAX_SECONDS=30
BULK_UPLOAD_SESSION_TTL_SECONDS=86400
BULK_UPLOAD_CHUNK_SIZE_BYTES=33554432
BULK_SHARDED_INGEST_ENABLED=true
BULK_SHARD_LINES_PER_PART=50000
# Only if this host runs app.worker_main (bulk worker container).
BULK_WORKER_MAX_CONCURRENT=2
PROCESS_QUEUE_TYPE=redis
REDIS_RETRY_BASE_SECONDS=1
REDIS_RETRY_MAX_SECONDS=30
REDIS_RETRY_ENQUEUE_MAX_ATTEMPTS=5
# Hot-path Redis reads (bulk cancel polls, parent shard aggregation). Raise on flaky LAN.
REDIS_RETRY_READ_MAX_ATTEMPTS=15
MOSAIC_QUEUE_TYPE=redis
# Homogeneous setup: use the same MOSAIC_SUBJOB_* / MOSAIC_QUEUE_TYPE values on API and every mosaic worker (no coordinator vs shard split required).
MOSAIC_SUBJOB_QUEUE_ENABLED=true
# Only used by standalone mosaic worker process (jobs per process).
MOSAIC_WORKER_MAX_CONCURRENT=2
# Upstream STAC fan-out controls for one large mosaic job (used by mosaic worker):
MOSAIC_STAC_INITIAL_SPLIT_THRESHOLD_DEGREES=6
MOSAIC_STAC_INITIAL_SPLIT_GRID=0
MOSAIC_STAC_BBOX_PARALLELISM=8
MOSAIC_STAC_DATETIME_PARALLELISM=4
MOSAIC_STAC_CATALOG_PARALLELISM=4
MOSAIC_STAC_TOTAL_INFLIGHT_MAX=12
MOSAIC_STAC_FETCH_LIMIT=250
MOSAIC_VOID_FILL_MAX_ROUNDS=4
MOSAIC_VOID_PINPOINT_MAX_PARTS=8
MOSAIC_VOID_FILL_MIN_UNCOVERED=0.001
MOSAIC_SAME_PASS_NUM_STRIPS=8
# Stop greedy cover after first scene when the next best adds less than this fraction of the current hole.
MOSAIC_GREEDY_MIN_MARGINAL_COVERAGE_FRACTION=0.005
MOSAIC_FOOTPRINT_FETCH_MAX_CONCURRENT=8
MOSAIC_FOOTPRINT_CPU_MAX_CONCURRENT=4
MOSAIC_FOOTPRINT_FETCH_CONNECT_TIMEOUT_SECONDS=5
MOSAIC_FOOTPRINT_FETCH_READ_TIMEOUT_SECONDS=20
MOSAIC_FOOTPRINT_MAX_ITEMS=200
MOSAIC_JOB_HEARTBEAT_SECONDS=10
MOSAIC_JOB_STALE_AFTER_SECONDS=180
MOSAIC_JOB_CLIENT_TIMEOUT_SECONDS=1800
MOSAIC_SUBJOB_WORKER_CONCURRENCY=2
MOSAIC_SUBJOB_CONSUME_SUBTASKS_WHILE_PARENT_ACTIVE=true
# Wave size ≈ total subtask slots (MOSAIC_SUBJOB_WORKER_CONCURRENCY × mosaic worker processes); single process: start near concurrency (e.g. 4–8), not 32.
MOSAIC_SUBJOB_BBOX_DATETIME_PARALLELISM=8
MOSAIC_SUBJOB_CATALOG_PARALLELISM=4
MOSAIC_SUBJOB_ROUND_TIMEOUT_SECONDS=180
MOSAIC_SUBJOB_MAX_RETRIES=1
MOSAIC_SUBJOB_RESULT_TTL_SECONDS=3600
MOSAIC_PARENT_FAIL_ON_PARTIAL=false
# Optional distributed thumbnail footprint_display (must match workers).
MOSAIC_FOOTPRINT_DISTRIBUTED_ENABLED=false
MOSAIC_FOOTPRINT_DISTRIBUTED_WAVE=16
MOSAIC_FOOTPRINT_DISTRIBUTED_TIMEOUT_SECONDS=300
MOSAIC_FOOTPRINT_SUBJOB_WORKER_CONCURRENCY=0
TILES_STORAGE_PATH=/data/tiles
RASTER_STORAGE_PATH=/data/rasters
TITILER_INTERNAL_URL=http://YOUR_TITILER_OR_NGINX:8000
TITILER_TILE_CACHE_TTL_SECONDS=3600
# Mosaic raster tiles only (Redis); keys include revision — safe to raise (e.g. 604800 = 7d). 0 = same as TITILER_TILE_CACHE_TTL_SECONDS.
TITILER_MOSAIC_TILE_CACHE_TTL_SECONDS=86400
RASTER_INTERNAL_FETCH_BASE_URL=http://YOUR_API_HOST:8000
TITILER_INTERNAL_SECRET=change-me-titiler-secret
# MosaicJSON COG hrefs: false = file paths under RASTER_STORAGE_PATH (Titiler must mount same path). true = HTTP internal COG URLs (GDAL vsicurl + ?token= can fail).
RASTER_MOSAIC_ASSET_HREFS_HTTP=false
TITILER_HTTP_READ_TIMEOUT_SECONDS=600
# Per API worker: max parallel httpx calls to Titiler (0 = unlimited). Waiters are LIFO when saturated.
TITILER_UPSTREAM_MAX_CONCURRENT=8
# Observability tracing (Tempo via OTEL Collector in deploy/compose/docker-compose.observability.yml)
OBSERVABILITY_TRACING_ENABLED=false
OBSERVABILITY_SERVICE_NAME=geofast_api
OBSERVABILITY_OTLP_ENDPOINT=http://otel_collector:4317
OBSERVABILITY_TRACE_SAMPLE_RATIO=0.1
# STAC upstream (Earth Search, etc.): Redis-backed caches reduce repeat traffic and 403/rate-limit risk.
# POST /search merge cache TTL (seconds). Use 604800 (7d) in production if results staleness is acceptable.
STAC_SEARCH_CACHE_TTL_SECONDS=604800
# Federated STAC retries on transient errors (502/503/504/429): exponential backoff capped to 5 minutes.
STAC_SEARCH_HTTP_MAX_RETRIES=8
STAC_SEARCH_HTTP_RETRY_BACKOFF_SECONDS=2
STAC_SEARCH_HTTP_RETRY_BACKOFF_MAX_SECONDS=300
# Follow STAC rel=next pages (small cap + tiny delay to avoid upstream burst).
STAC_SEARCH_HTTP_MAX_PAGES=2
STAC_SEARCH_HTTP_PAGE_DELAY_SECONDS=0.25
# GET /collections listing per catalog (seconds). 604800 = 7d.
STAC_COLLECTIONS_CACHE_TTL_SECONDS=604800
# GET Item JSON (seconds); shared across API workers. 604800 = 7d.
STAC_ITEM_REDIS_CACHE_TTL_SECONDS=604800
